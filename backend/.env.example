# Settings of the API (backend/api.py, api_v2.py, api_3d.py). Every variable is optional. Copy this file to `.env` (it is ignored
# by Git) and start the API from backend/ with
#     python -m uvicorn api:app --host 127.0.0.1 --port 8000 --env-file .env
# (--env-file needs python-dotenv, which comes with the uvicorn[standard] package of requirements-api.txt). The API does not read
# `.env` by itself: without --env-file, set the variables in the shell or in the hosting service.
# Nothing in this file is a secret. The API has no accounts, keys or database.

# Origins (the address of the page, without a path) that may call the API from a browser, separated by commas.
# http://127.0.0.1:5173 and http://localhost:5173 are always allowed. A hosted dashboard must be listed here.
CORS_ORIGINS=

# Recorded benchmark runs to serve: read-only directories that hold the result CSV files and run_metadata.json. A relative path
# is taken from the backend/ folder. Without them the benchmark pages say that no run is configured and show nothing.
BENCHMARK_RUN_DIRS=docs/results/benchmark_v2_methods_2026-10-25

# The two recorded Benchmark 3D runs. Several directories are separated by ";" on Windows and by ":" on Linux and macOS, so the
# value depends on the system: uncomment the line for yours (a wrong separator is not an error, the runs are just not found).
# BENCHMARK_3D_RUN_DIRS=docs/results/benchmark_3d_2026-10-26;docs/results/benchmark_3d_correlated_2026-10-27
# BENCHMARK_3D_RUN_DIRS=docs/results/benchmark_3d_2026-10-26:docs/results/benchmark_3d_correlated_2026-10-27

# Optional: the folder of the DICOM series that the Benchmark V2 run was made from. It is not part of the repository (see the README);
# with it the Benchmark V2 page can redraw the compared images from the recorded seeds. Leave empty otherwise.
CT_SERIES_DIR=

# Resource limits that bound memory and processing time per request. These are the defaults of the code;
# render.yaml sets tighter values for a 512 MB instance.
MAX_UPLOAD_MB=25
MAX_IMAGE_PIXELS=4194304
MAX_ADVANCED_PIXELS=1048576
MAX_CONCURRENT_JOBS=2
MAX_CT_FILES=400
MAX_CT_TOTAL_MB=200
